<UserControl x:Class="deavnote.app.Controls.MarkdownTextBox"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto, *">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="80" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" MinWidth="80" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Margin="20,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Orientation="Horizontal" Spacing="20">
            <Button x:Name="EditModeButton" Classes="Icon">
                <ic:FluentIcon Icon="Edit" IconSize="Size16" />
            </Button>
            <Button x:Name="SplitModeButton" Classes="Icon">
                <ic:FluentIcon Icon="SplitVertical" IconSize="Size16" />
            </Button>
            <Button x:Name="ViewModeButton" Classes="Icon">
                <ic:FluentIcon Icon="Eye" IconSize="Size16" />
            </Button>
        </StackPanel>

        <TextBox x:Name="MarkdownTexBox"
                 Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                 Height="300"
                 Margin="0,0,10,0"
                 AcceptsReturn="True" />

        <GridSplitter x:Name="ViewSplitter"
                      Grid.Row="1"
                      Height="200"
                      Background="{StaticResource Grey1}"
                      BorderBrush="{StaticResource Grey4}"
                      BorderThickness="2" CornerRadius="2" IsVisible="False"
                      ResizeDirection="Columns" />

        <md:MarkdownRenderer x:Name="MarkdownRenderer"
                             Grid.Row="1"
                             Height="300"
                             Margin="10,0,0,0"
                             IsVisible="False" />
    </Grid>

</UserControl>
