<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:deavnote.app.Controls"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:loc="using:deavnote.app.Localization"
        xmlns:md="using:LiveMarkdown.Avalonia">

    <Style Selector="md|MarkdownTextBlock">
        <Setter Property="Foreground" Value="{StaticResource White2}" />
    </Style>

</Styles>
