<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel Width="200" Height="200">
            <TextBlock Classes="Content">
                some text
            </TextBlock>
            <TextBlock Classes="Content Muted">
                some text
            </TextBlock>
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="TextBlock.Title">
        <Setter Property="Foreground" Value="{StaticResource White1Brush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Margin" Value="5,10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.Content">
        <Setter Property="Foreground" Value="{StaticResource White1Brush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.Content.Muted">
        <Setter Property="Foreground" Value="{StaticResource White3Brush}" />
    </Style>

    <Style Selector="TextBlock.Legend">
        <Setter Property="Foreground" Value="{StaticResource White1Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="TextBlock.CardLegend">
        <Setter Property="Foreground" Value="{StaticResource White3Brush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.Banner">
        <Setter Property="Foreground" Value="{StaticResource White1Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.Banner.Blue">
        <Setter Property="Foreground" Value="CadetBlue" />
    </Style>

    <Style Selector="TextBlock.Banner.Violet">
        <Setter Property="Foreground" Value="MediumSlateBlue" />
    </Style>

    <Style Selector="TextBlock.Banner.Gray">
        <Setter Property="Foreground" Value="LightSlateGray" />
    </Style>

    <Style Selector="TextBlock.Banner.Red">
        <Setter Property="Foreground" Value="Red" />
    </Style>

    <Style Selector="TextBlock.Banner.Orange">
        <Setter Property="Foreground" Value="Orange" />
    </Style>

    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="Foreground" Value="{StaticResource White1Brush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="DataValidationErrors ItemsControl TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Error1Brush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="SelectableTextBlock.CardContent">
        <Setter Property="Foreground" Value="{StaticResource White1Brush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="SelectableTextBlock.CardTitle">
        <Setter Property="Foreground" Value="{StaticResource White2Brush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="DemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="SelectableTextBlock.CardTitle.Code">
        <Setter Property="Foreground" Value="{StaticResource Violet2Brush}" />
    </Style>

    <Style Selector="SelectableTextBlock.Legend">
        <Setter Property="Foreground" Value="{StaticResource White1Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

</Styles>